@baseUrl = http://localhost:8090

### 登录并获取token
# @name login
POST {{baseUrl}}/login
content-type:application/json

{
    "email": "test@example.com",
    "password": "he123"
}

### 创建事件（# @name 让后续请求能直接引用新建事件的 id）
# @name createEvent
POST {{baseUrl}}/events
content-type:application/json
authorization:Bearer {{login.response.body.$.token}}

{
    "name": "New Event",
    "description": "This is a new test event",
    "location": "New Location",
    "dateTime": "2026-09-21T12:00:00Z"
}

### 报名事件（成功返回 201 registered!）
POST {{baseUrl}}/events/{{createEvent.response.body.$.event.ID}}/register
authorization:Bearer {{login.response.body.$.token}}

### 重复报名（应返回 409）
POST {{baseUrl}}/events/{{createEvent.response.body.$.event.ID}}/register
authorization:Bearer {{login.response.body.$.token}}

### 通过事件id查报名用户（报名后应能看到自己的 email）
GET {{baseUrl}}/events/{{createEvent.response.body.$.event.ID}}/attendees
authorization:Bearer {{login.response.body.$.token}}

### 报名检查（应返回上面报名的事件）
GET {{baseUrl}}/registrations/me
authorization:Bearer {{login.response.body.$.token}}

### 取消报名
DELETE {{baseUrl}}/events/{{createEvent.response.body.$.event.ID}}/register
authorization:Bearer {{login.response.body.$.token}}

### 取消后再查报名用户（应为空数组 []）
GET {{baseUrl}}/events/{{createEvent.response.body.$.event.ID}}/attendees
authorization:Bearer {{login.response.body.$.token}}

### 取消后再做报名检查（应为空数组 []）
GET {{baseUrl}}/registrations/me
authorization:Bearer {{login.response.body.$.token}}

### 未登录报名（应返回 401）
POST {{baseUrl}}/events/1/register

### 更新事件
PUT {{baseUrl}}/events/1
content-type:application/json
authorization:Bearer {{login.response.body.$.token}}

{
    "name": "Update 3 Event",
    "description": "This is a update event",
    "location": "Update Location",
    "dateTime": "2023-04-01T12:00:00Z"
}

### 删除事件
DELETE {{baseUrl}}/events/1
authorization:Bearer {{login.response.body.$.token}}

### 查询事件
GET {{baseUrl}}/events
authorization:Bearer {{login.response.body.$.token}}

### 通过事件id查询单个事件
GET {{baseUrl}}/events/1
authorization:Bearer {{login.response.body.$.token}}
